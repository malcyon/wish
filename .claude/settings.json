{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/check-issue-titles.py"
          },
          {
            "type": "command",
            "command": "nohup \"$CLAUDE_PROJECT_DIR/.claude/hooks/backup-work.sh\" >/dev/null 2>&1 &"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/issue-titles-context.py"
          },
          {
            "type": "command",
            "command": "nohup \"$CLAUDE_PROJECT_DIR/.claude/hooks/backup-work.sh\" >/dev/null 2>&1 &"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/check-gh-issue-titles.py"
          }
        ]
      }
    ]
  }
}
