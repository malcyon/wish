{
  "mcpServers": {
    "vice": {
      "command": "node",
      "args": [
        "${HOME}/src/mcp-vice-emu/dist/index.js"
      ],
      "env": {
        "VICE_PATH": "${VICE_PATH:-/usr/bin}",
        "VICE_EMULATOR": "x64sc",
        "VICE_MONITOR_PORT": "6502"
      }
    },
    "qt-docs": {
      "type": "http",
      "url": "https://qt-docs-mcp.qt.io/mcp"
    }
  }
}
