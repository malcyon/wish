{# Managed by Ansible — roles/agent-vm #}
{# DHCP from the sandbox network, whose dnsmasq holds a fixed lease for this
   MAC and hands out its own gateway as DNS. Matched on the MAC rather than a
   name, so it does not depend on what the kernel calls the virtio NIC. #}
version: 2
ethernets:
  eth0:
    match:
      macaddress: "{{ agent_vm_mac }}"
    set-name: eth0
    dhcp4: true
    dhcp6: false
