# Managed by Ansible — roles/agent-vm.
#
# A writable view of the agent VM's whole filesystem, to browse and edit in a local
# GUI. Writes reach the guest as its {{ agent_vm_user }} account, and the guest's own permissions decide
# what that account may change. No editor server runs in the guest: the only thing
# on its side is sshd, which is already there.
#
# Mounted by the person, not by root, and neither allow_other nor allow_root is set,
# so only that person can reach the mount; nothing is added to /etc/fuse.conf. The
# guest is untrusted, so the mount is hardened:
#   * follow_symlinks: a symlink the guest plants is resolved on the guest, so an
#     editor that opens or saves through one never touches a file on this desktop.
#   * noexec: nothing on the guest is ever run on this desktop from the mount.
# Each way it can go wrong is answered here:
#   * The guest is down when this starts, or reboots later: sshfs exits or
#     reconnects, and systemd starts it again every {{ agent_vm_wish_mount_retry }} seconds until it can.
#   * The guest dies while it is mounted: ssh notices within a few seconds
#     (ServerAlive*), the reconnect fails within ConnectTimeout, and a request on
#     the mount point returns an error instead of hanging. A stale mount from a
#     crashed sshfs is cleared before each start, and again on stop.
[Unit]
Description=Writable view of the {{ agent_vm_name }} filesystem as {{ agent_vm_user }} at {{ agent_vm_wish_mount }}
# A guest that stays down is not a reason to give up.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStartPre=-/usr/bin/fusermount3 -uz {{ agent_vm_wish_mount }}
ExecStart=/usr/bin/sshfs -f {{ agent_vm_name }}:{{ agent_vm_wish_remote }} {{ agent_vm_wish_mount }} \
    -o reconnect,ServerAliveInterval={{ agent_vm_wish_mount_alive }},ServerAliveCountMax=2,ConnectTimeout=3,BatchMode=yes,cache_timeout=2,follow_symlinks,noexec
ExecStopPost=-/usr/bin/fusermount3 -uz {{ agent_vm_wish_mount }}
Restart=always
RestartSec={{ agent_vm_wish_mount_retry }}

[Install]
WantedBy=default.target
