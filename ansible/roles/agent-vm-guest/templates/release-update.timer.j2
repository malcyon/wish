# Managed by Ansible — roles/agent-vm-guest.
[Unit]
Description=Bring {{ agent_guest_tool_name }} up to date, weekly

[Timer]
OnCalendar={{ agent_guest_release_schedule }}
# A guest that was off at the time runs it when it next starts.
Persistent=true
RandomizedDelaySec=1h

[Install]
WantedBy=timers.target
