#!/usr/bin/env python3
# Managed by Ansible — roles/agent-vm-guest.
"""Bring {{ agent_guest_tool_name }} up to date and point ~/.local/bin/{{ agent_guest_tool_name }} at it.

Asks GitHub for the newest {{ agent_guest_tool.repo }} release, or for exactly the tag the tool is
pinned to, and installs it under ~/.local/share/{{ agent_guest_tool_name }}/<tag> only if that tag is
not already there. A pinned tool never moves to a newer release. Run by the playbook, and weekly by
the {{ agent_guest_tool_name }}-update systemd user timer for a tool that is not pinned, so the guest
keeps itself current between playbook runs.

The download is checked against the SHA-256 GitHub publishes for the asset in the
same API response, and nothing is installed without one. Each version has a
directory of its own and the symlink moves last, so a run that fails part way
leaves the working Codex where it was, and a Codex already running keeps the
binary it started from. The newest {{ agent_guest_release_keep }} versions are kept.
"""
import fcntl
import hashlib
import json
import os
import re
import shutil
import sys
import tarfile
import tempfile
import urllib.request
from pathlib import Path

NAME = "{{ agent_guest_tool_name }}"
REPO = "{{ agent_guest_tool.repo }}"
ASSET = "{{ agent_guest_tool.asset }}"
BINARY = "{{ agent_guest_tool.binary }}"
ARCHIVE = {{ 'True' if agent_guest_tool.archive else 'False' }}
KEEP = {{ agent_guest_release_keep }}
PINNED_TAG = "{{ agent_guest_tool.version | default('') }}"

HOME = Path.home()
VERSIONS = HOME / ".local/share" / NAME
LINK = HOME / ".local/bin" / NAME


def get(url):
    # GitHub refuses requests with no User-Agent.
    request = urllib.request.Request(
        url, headers={"User-Agent": f"{NAME}-update", "Accept": "application/vnd.github+json"}
    )
    return urllib.request.urlopen(request, timeout=60)


def release_url():
    base = f"https://api.github.com/repos/{REPO}/releases"
    return f"{base}/tags/{PINNED_TAG}" if PINNED_TAG else f"{base}/latest"


def version_key(name):
    match = re.search(r"(\d+(?:\.\d+)*)", name)
    return tuple(int(part) for part in match.group(1).split(".")) if match else None


def install(tag, asset, sha256, target):
    # Unpacked beside its destination, so the final rename is atomic.
    work = Path(tempfile.mkdtemp(prefix=f".{tag}.", dir=VERSIONS))
    try:
        asset_file = work / "asset"
        digest = hashlib.sha256()
        with get(asset["browser_download_url"]) as response, open(asset_file, "wb") as out:
            for chunk in iter(lambda: response.read(1 << 20), b""):
                digest.update(chunk)
                out.write(chunk)
        if digest.hexdigest() != sha256:
            sys.exit(f"{tag}: the download's SHA-256 is {digest.hexdigest()}, GitHub says {sha256}")
        unpacked = work / "unpacked"
        unpacked.mkdir()
        if ARCHIVE:
            with tarfile.open(asset_file) as tar:
                tar.extractall(unpacked, filter="data")
        else:
            shutil.move(asset_file, unpacked / BINARY)  # the asset is the binary itself
        if not (unpacked / BINARY).is_file():
            sys.exit(f"{tag}: {ASSET} does not contain {BINARY}")
        os.chmod(unpacked / BINARY, 0o755)
        if target.exists():
            shutil.rmtree(target)  # a directory with no binary in it: an earlier run's wreckage
        os.rename(unpacked, target)
    finally:
        shutil.rmtree(work, ignore_errors=True)


def point_at(binary):
    LINK.parent.mkdir(parents=True, exist_ok=True)
    staged = LINK.with_name(LINK.name + ".new")
    staged.unlink(missing_ok=True)
    staged.symlink_to(binary)
    os.replace(staged, LINK)


def prune(current):
    for leftover in VERSIONS.glob(".*.*"):
        if leftover.is_dir():
            shutil.rmtree(leftover, ignore_errors=True)
    kept = sorted(
        (d for d in VERSIONS.iterdir() if d.is_dir() and version_key(d.name)),
        key=lambda d: version_key(d.name),
        reverse=True,
    )
    for old in kept[KEEP:]:
        if old.name != current:
            shutil.rmtree(old)
            print(f"removed {old.name}")


def main():
    VERSIONS.mkdir(parents=True, exist_ok=True)
    lock = open(VERSIONS / ".lock", "w")
    fcntl.flock(lock, fcntl.LOCK_EX)  # the timer and a playbook run must not overlap

    with get(release_url()) as response:
        release = json.load(response)
    tag = release["tag_name"]
    if not re.fullmatch(r"[A-Za-z0-9._-]+", tag):
        sys.exit(f"refusing a release tag that is not a simple name: {tag!r}")
    asset = next((a for a in release["assets"] if a["name"] == ASSET), None)
    if asset is None:
        sys.exit(f"{tag} has no {ASSET}")
    digest = asset.get("digest") or ""
    if not digest.startswith("sha256:"):
        sys.exit(f"{tag}: GitHub publishes no SHA-256 for {ASSET}, so it will not be installed")

    target = VERSIONS / tag
    if (target / BINARY).is_file():
        print(f"{NAME} {tag}: already present")
    else:
        install(tag, asset, digest.split(":", 1)[1], target)
        print(f"{NAME} {tag}: downloaded and installed")
    point_at(target / BINARY)
    print(f"{LINK} -> {target / BINARY}")
    prune(tag)


if __name__ == "__main__":
    main()
