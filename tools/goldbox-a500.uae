config_description=Gold Box, A500 with Kickstart 1.3
config_hardware=true
config_host=true

; Host side. use_gui=no is the line that makes an unattended run possible at
; all: without it WinUAE opens its settings dialog and waits for a human.
use_gui=no
win32.start_not_captured=true
win32.inactive_pause=false
win32.inactive_nosound=true
win32.iconified_pause=false
win32.ctrl_F11_is_quit=false
; sound_output=interrupts is silent on the host and NOT the same as none:
; "none" turns Paula's emulation off altogether, audio interrupts included, and
; Amiga Silver Blades then deadlocks the second time the party turns. Measured
; on 2026-09-07 at square 5,9 of Silver Blades' opening area: with
; sound_output=none the first turn drew and the second wrote the new facing to
; the game's own byte and never redrew, and the Secret process sat in Exec's
; Wait on one signal nothing would ever send, with the keypress it had not read
; still in the console buffer; with sound_output=interrupts, eight turns and
; three steps in a row, every one drawn. #361 (An Amiga party cannot be made to
; walk, because the WinUAE driver sends only keystrokes).
sound_output=interrupts
gfx_display=0
gfx_framerate=1
gfx_width_windowed=720
gfx_height_windowed=568
gfx_fullscreen_amiga=false
gfx_fullscreen_picasso=false
gfx_lores=false
gfx_linemode=double
gfx_colour_mode=32bit
gfx_vsync=false

; Amiga side: a stock A500 -- OCS, 68000, 512K chip plus 512K slow, Kickstart
; 1.3. Every Gold Box Amiga title is a 1989-1992 floppy release and boots from
; its own bootblock, so nothing later is needed and a later Kickstart only adds
; ways to fail.
kickstart_rom_file=C:\Amiga\Kickstarts\kick34005.A500
chipset=ocs
chipset_compatible=A500
cpu_type=68000
cpu_model=68000
cpu_speed=real
cpu_compatible=true
cpu_cycle_exact=false
blitter_cycle_exact=false
chipmem_size=1
bogomem_size=2
fastmem_size=0
z3mem_size=0
immediate_blits=false
collision_level=playfields

; Two drives, both turbo. floppy_speed=800 is not cosmetic: at the real 100
; Curse was still a blank white screen 35 seconds in, which reads as a hang to
; anything watching by screenshot.
nr_floppies=2
floppy0type=0
floppy1type=0
floppy_speed=800
floppy0=C:\Amiga\Disks\Curse_Of_The_Azure_Bonds\CurseOfTheAzureBonds_A.adf
floppy1=C:\Amiga\Disks\Curse_Of_The_Azure_Bonds\CurseOfTheAzureBonds_B.adf

; joyport1=none is the line that lets a party walk. WinUAE's default_prefs()
; stores "mouse" in port 1 and "kbd1" in port 2, and kbd1 is Keyboard Layout A:
; inputdevice.cpp's setcompakb() then overwrites DIK_NUMPAD4, 6, 8, 2, 0, 5,
; DECIMAL and NUMPADENTER with joystick events, so those keys stop reaching the
; Amiga's keyboard at all. Amiga Curse and Amiga Silver Blades move the party
; on the numeric keypad -- each patches the console keymap so Amiga rawkeys
; $0F, $1D-$1F, $2D-$2F and $3D-$3F return $B0-$B9 -- so the default silently
; ate every movement key, which is the twenty-key negative result in #361 (An
; Amiga party cannot be made to walk, because the WinUAE driver sends only
; keystrokes). Neither title ever opens gameport.device -- the flag its
; open routine sets reads 0 in the running game -- so a joystick in port 2
; would be read by nobody. Port 1 keeps WinUAE's own default, a mouse, because
; a mouse steals no key.
joyport0=mouse
joyport1=none

; F11 opens WinUAE's debugger. There is no other way in on the Windows port:
; od-win32/win32.cpp's debuggable() returns 0 unconditionally, so main.cpp's
; `if (currprefs.start_debugger && debuggable()) activate_debugger()` never
; fires and use_debugger=true does nothing. The only caller left is the
; SPC_ENTERDEBUGGER input event, which has no default binding.
input.config=1
input.1.keyboard.0.friendlyname=WinUAE keyboard
input.1.keyboard.0.name=NULLKEYBOARD
input.1.keyboard.0.empty=false
input.1.keyboard.0.button.87.0=SPC_ENTERDEBUGGER
